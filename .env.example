# ⚙️ Konfigurasi Supabase untuk aplikasi Layanan PPA

# URL project Supabase kamu (bisa dilihat di Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key Supabase (Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
